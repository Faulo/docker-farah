{
    "schemaVersion": 3,
    "namespace": "$DOCKER_NAMESPACE",
    "image": "$DOCKER_IMAGE",
    "description": "Farah CMS with Apache, PHP, and Composer for Linux and Windows containers",
    "overviewFile": "README.md",
    "context": ".",
    "cleanupWindowsRunner": true,
    "matrix": {
        "version": {
            "buildArgs": {
                "PHP_VERSION": "{{matrix.version}}"
            },
            "tags": {
                "7.4": {},
                "8.0": {},
                "8.1": {},
                "8.2": {},
                "8.3": {},
                "8.4": {},
                "8.5": {
                    "aliases": [
                        "latest"
                    ]
                }
            }
        },
        "os": {
            "dockerfile": "{{matrix.os}}/Dockerfile",
            "tags": {
                "linux": {
                    "matrix": {
                        "architecture": {
                            "tags": {
                                "amd64": {
                                    "runner": "ubuntu-latest"
                                },
                                "arm64": {
                                    "runner": "ubuntu-24.04-arm"
                                }
                            }
                        }
                    }
                },
                "windows": {
                    "runner": "windows-latest",
                    "matrix": {
                        "release": {
                            "tags": {
                                "ltsc2019": {}
                            }
                        }
                    }
                }
            }
        }
    }
}
